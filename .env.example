# Copia este archivo a .env.local y rellena lo que tengas disponible.
# FootVision funciona con datos simulados si no configuras nada.

# Clave para firmar las cookies de sesion (obligatoria en produccion)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Opcional: si se define, el Centro de Ojeo usa la API de OpenAI para
# generar los informes profesionales. Sin ella, se usa un generador
# heuristico local (sin coste) que produce informes igualmente coherentes.
OPENAI_API_KEY=

# Opcional: token de football-data.org (cuenta gratuita en football-data.org).
# Con esto definido, Partidos y Clasificaciones son reales para LaLiga,
# Premier League, Bundesliga, Ligue 1 y Serie A. Todo lo demas (jugadores,
# valor de mercado, plantillas, mercado de fichajes, Centro de Ojeo) sigue
# siendo el dataset simulado, porque el plan gratuito de esta API no lo cubre.
# Sin configurar, FootVision funciona igualmente con el dataset simulado.
FOOTBALL_DATA_API_KEY=

# Opcional: clave de API-Football (cuenta gratuita en dashboard.api-football.com
# o en api-football.com, NO es lo mismo que football-data.org de arriba).
# Con esto definido, la ficha de un club que aparezca en partidos reales pero
# no este en nuestro dataset curado (los ~10 clubes con ficha rica) muestra
# su plantilla completa, lesiones y fichajes recientes reales. No incluye
# valor de mercado (esa metrica solo la calcula Transfermarkt, sin API
# gratuita disponible). Sin configurar, esas fichas se quedan como estan hoy.
API_FOOTBALL_KEY=

# Opcional: ID de editor de Google AdSense (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
